+/******************************************************************************
+ * Auto-Reclocking
+ *
+ * The pstate table is only walked once at ctor, leaving discrete GPUs
+ * fixed at the performance state they booted at.  This implements a
+ * simple ondemand-style policy, driven by the PMU idle counters, that
+ * adjusts the perfmon pstate (clk->astate) whenever the "auto" (-2)
+ * state is requested via the NvAutoClk / NvClkMode config options or
+ * the "pstate" debugfs file.
+ *****************************************************************************/
+#define NVKM_CLK_AUTO_INTERVAL		250000000ULL /* sampling period (ns) */
+
+#define NVKM_CLK_AUTO_UP		450	/* busy: raise pstate */
+#define NVKM_CLK_AUTO_DOWN		300	/* busy: lower pstate */
+#define NVKM_CLK_AUTO_BOOST		900	/* busy: raise directly to max */
+#define NVKM_CLK_AUTO_UP_SAMPLES	3
+#define NVKM_CLK_AUTO_DOWN_SAMPLES	10
+
+#define NVKM_CLK_AUTO_TEMP_SOFT	90	/* block raising the pstate */
+#define NVKM_CLK_AUTO_TEMP_HARD	95	/* force the lowest pstate */
+
+/* PMU idle-counter registers (see gk20a_devfreq.c for the semantics). */
+#define NVKM_CLK_AUTO_IDLE_CTRL		0x0010a50c
+#define NVKM_CLK_AUTO_IDLE_MASK		0x0010a504
+#define NVKM_CLK_AUTO_IDLE_COUNT	0x0010a508
+#define NVKM_CLK_AUTO_IDLE_COUNT_SIZE	0x10
+#define NVKM_CLK_AUTO_IDLE_TOTAL	0
+#define NVKM_CLK_AUTO_IDLE_BUSY		4
+#define NVKM_CLK_AUTO_IDLE_COUNT_MASK	0x7fffffff
+#define NVKM_CLK_AUTO_IDLE_COUNT_RESET	0x80000000
+#define NVKM_CLK_AUTO_IDLE_CTRL_MASK	0x7
+#define NVKM_CLK_AUTO_IDLE_CTRL_ALWAYS	0x3
+#define NVKM_CLK_AUTO_IDLE_CTRL_BUSY	0x2
+#define NVKM_CLK_AUTO_IDLE_BUSY_MASK	0x00200001 /* GR | CE2 */
+#define NVKM_CLK_AUTO_IDLE_THRESHOLD	0x0010a8a0
+#define NVKM_CLK_AUTO_IDLE_INTR_EN	0x0010a9e8
+#define NVKM_CLK_AUTO_IDLE_INTR_ST	0x0010a9ec
+
+static void
+nvkm_clk_auto_counter_init(struct nvkm_clk *clk)
+{
+	struct nvkm_device *device = clk->subdev.device;
+	u32 data;
+
+	/* No interrupt handling - the counters are polled. */
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_INTR_EN, 0x00000000);
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_THRESHOLD, 0x7fffffff);
+
+	/* Total cycles: count always. */
+	data = nvkm_rd32(device, NVKM_CLK_AUTO_IDLE_CTRL +
+			 (NVKM_CLK_AUTO_IDLE_TOTAL * NVKM_CLK_AUTO_IDLE_COUNT_SIZE));
+	data &= ~NVKM_CLK_AUTO_IDLE_CTRL_MASK;
+	data |= NVKM_CLK_AUTO_IDLE_CTRL_ALWAYS;
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_CTRL +
+		  (NVKM_CLK_AUTO_IDLE_TOTAL * NVKM_CLK_AUTO_IDLE_COUNT_SIZE), data);
+
+	/* Busy cycles: count when GR / CE2 are active. */
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_MASK +
+		  (NVKM_CLK_AUTO_IDLE_BUSY * NVKM_CLK_AUTO_IDLE_COUNT_SIZE),
+		  NVKM_CLK_AUTO_IDLE_BUSY_MASK);
+	data = nvkm_rd32(device, NVKM_CLK_AUTO_IDLE_CTRL +
+			 (NVKM_CLK_AUTO_IDLE_BUSY * NVKM_CLK_AUTO_IDLE_COUNT_SIZE));
+	data &= ~NVKM_CLK_AUTO_IDLE_CTRL_MASK;
+	data |= NVKM_CLK_AUTO_IDLE_CTRL_BUSY;
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_CTRL +
+		  (NVKM_CLK_AUTO_IDLE_BUSY * NVKM_CLK_AUTO_IDLE_COUNT_SIZE), data);
+}
+
+static void
+nvkm_clk_auto_counter_reset(struct nvkm_clk *clk)
+{
+	struct nvkm_device *device = clk->subdev.device;
+
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_COUNT +
+		  (NVKM_CLK_AUTO_IDLE_TOTAL * NVKM_CLK_AUTO_IDLE_COUNT_SIZE),
+		  NVKM_CLK_AUTO_IDLE_COUNT_RESET);
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_COUNT +
+		  (NVKM_CLK_AUTO_IDLE_BUSY * NVKM_CLK_AUTO_IDLE_COUNT_SIZE),
+		  NVKM_CLK_AUTO_IDLE_COUNT_RESET);
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_INTR_ST, 0x00000001);
+}
+
+static void
+nvkm_clk_auto_thermal_downclock(struct nvkm_therm *therm, bool active)
+{
+	struct nvkm_clk *clk = therm->subdev.device->clk;
+
+	if (!clk)
+		return;
+	clk->auto_downclock = active;
+	if (active)
+		nvkm_clk_astate(clk, clk->dstate, 0, false);
+}
+
+static void
+nvkm_clk_auto_enable(struct nvkm_clk *clk)
+{
+	struct nvkm_device *device = clk->subdev.device;
+
+	if (!device->timer)
+		return;
+	if (clk->auto_active)
+		return;
+	clk->auto_active = true;
+	clk->auto_busy = 0;
+	clk->auto_up = 0;
+	clk->auto_down = 0;
+	clk->auto_downclock = false;
+
+	nvkm_clk_auto_counter_init(clk);
+	nvkm_clk_auto_counter_reset(clk);
+
+	if (device->therm)
+		device->therm->emergency.downclock = nvkm_clk_auto_thermal_downclock;
+
+	nvkm_info(&clk->subdev, "auto-reclocking enabled\n");
+	nvkm_timer_alarm(device->timer, NVKM_CLK_AUTO_INTERVAL, &clk->auto_alarm);
+}
+
+static void
+nvkm_clk_auto_disable(struct nvkm_clk *clk)
+{
+	struct nvkm_device *device = clk->subdev.device;
+
+	if (!clk->auto_active)
+		return;
+	clk->auto_active = false;
+	if (device->timer)
+		nvkm_timer_alarm(device->timer, 0, &clk->auto_alarm);
+
+	if (device->therm &&
+	    device->therm->emergency.downclock == nvkm_clk_auto_thermal_downclock)
+		device->therm->emergency.downclock = NULL;
+}
+
+static void
+nvkm_clk_auto_alarm(struct nvkm_alarm *alarm)
+{
+	struct nvkm_clk *clk = container_of(alarm, typeof(*clk), auto_alarm);
+	struct nvkm_device *device = clk->subdev.device;
+	struct nvkm_therm *therm = device->therm;
+	u32 busy, total, intr;
+	int astate = clk->astate, temp = -1;
+
+	if (!clk->auto_active)
+		return;
+
+	/* Read and reset the PMU idle counters. */
+	intr  = nvkm_rd32(device, NVKM_CLK_AUTO_IDLE_INTR_ST) & 0x00000001;
+	busy  = nvkm_rd32(device, NVKM_CLK_AUTO_IDLE_COUNT +
+			  (NVKM_CLK_AUTO_IDLE_BUSY * NVKM_CLK_AUTO_IDLE_COUNT_SIZE)) &
+			  NVKM_CLK_AUTO_IDLE_COUNT_MASK;
+	total = nvkm_rd32(device, NVKM_CLK_AUTO_IDLE_COUNT +
+			  (NVKM_CLK_AUTO_IDLE_TOTAL * NVKM_CLK_AUTO_IDLE_COUNT_SIZE)) &
+			  NVKM_CLK_AUTO_IDLE_COUNT_MASK;
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_COUNT +
+		  (NVKM_CLK_AUTO_IDLE_BUSY * NVKM_CLK_AUTO_IDLE_COUNT_SIZE),
+		  NVKM_CLK_AUTO_IDLE_COUNT_RESET);
+	nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_COUNT +
+		  (NVKM_CLK_AUTO_IDLE_TOTAL * NVKM_CLK_AUTO_IDLE_COUNT_SIZE),
+		  NVKM_CLK_AUTO_IDLE_COUNT_RESET);
+	if (intr)
+		nvkm_wr32(device, NVKM_CLK_AUTO_IDLE_INTR_ST, 0x00000001);
+
+	/* Total-counter overflow, or an inconsistent sample: assume the
+	 * GPU is fully busy, like the gk20a implementation does.
+	 */
+	if (intr || !total || busy > total)
+		busy = 1000;
+	else
+		busy = (u32)div64_u64((u64)busy * 1000, total);
+
+	/* Exponential moving average of the busy time. */
+	clk->auto_busy = ((clk->auto_busy * 7) + busy) / 8;
+
+	/* Keep the temperature used for c-state/voltage selection fresh. */
+	if (therm)
+		temp = nvkm_therm_temp_get(therm);
+	if (temp >= 0)
+		nvkm_clk_tstate(clk, temp);
+
+	/* Thermal emergency (therm downclock threshold, or extreme
+	 * temperature): force the lowest pstate.
+	 */
+	if (clk->auto_downclock || (temp >= 0 && temp >= NVKM_CLK_AUTO_TEMP_HARD)) {
+		clk->auto_up = 0;
+		clk->auto_down = 0;
+		astate = clk->dstate;
+		goto out;
+	}
+
+	/* High temperature: block raising the pstate. */
+	if (temp >= NVKM_CLK_AUTO_TEMP_SOFT) {
+		clk->auto_up = 0;
+		if (clk->auto_busy < NVKM_CLK_AUTO_DOWN &&
+		    ++clk->auto_down >= NVKM_CLK_AUTO_DOWN_SAMPLES) {
+			clk->auto_down = 0;
+			astate--;
+		} else if (clk->auto_busy >= NVKM_CLK_AUTO_DOWN) {
+			clk->auto_down = 0;
+		}
+		goto out;
+	}
+
+	/* Raise on sustained load: one pstate per step, or directly to
+	 * the highest pstate on very high load.
+	 */
+	if (clk->auto_busy >= NVKM_CLK_AUTO_UP) {
+		if (++clk->auto_up >= NVKM_CLK_AUTO_UP_SAMPLES) {
+			clk->auto_up = 0;
+			if (clk->auto_busy >= NVKM_CLK_AUTO_BOOST)
+				astate = clk->state_nr - 1;
+			else
+				astate++;
+		}
+		clk->auto_down = 0;
+	} else {
+		clk->auto_up = 0;
+	}
+
+	/* Lower on sustained idleness, one pstate per step. */
+	if (clk->auto_busy < NVKM_CLK_AUTO_DOWN) {
+		if (++clk->auto_down >= NVKM_CLK_AUTO_DOWN_SAMPLES) {
+			clk->auto_down = 0;
+			astate--;
+		}
+	} else {
+		clk->auto_down = 0;
+	}
+
+out:
+	if (clk->auto_active) {
+		if (astate != clk->astate)
+			nvkm_clk_astate(clk, astate, 0, false);
+		nvkm_timer_alarm(device->timer, NVKM_CLK_AUTO_INTERVAL, &clk->auto_alarm);
+	}
+}
